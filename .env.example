# ─── Runtime environment (PFL-169) ───────────────────────────────────────────
# production | staging | development. Required when deployed: Cloud Functions
# does not set NODE_ENV. Off-platform (tests, emulator) defaults to development.
PROOFLINE_ENV=development

# ─── Provider selection ──────────────────────────────────────────────────────
# Chosen explicitly; a real provider with missing settings is a startup error,
# never a silent fallback. In staging/production EMAIL/ANCHOR/KMS must be set;
# stub is refused for them in production.
EMAIL_PROVIDER=stub          # resend | stub
ANCHOR_PROVIDER=stub         # base-sepolia | stub
KMS_PROVIDER=stub            # gcp | stub
KYB_PROVIDER=stub            # stub | baselayer | cobalt   (baselayer needs BASELAYER_API_KEY + BASELAYER_WEBHOOK_SECRET; cobalt needs COBALT_API_KEY)
AI_PROVIDER=heuristic        # heuristic | gemini | none    (wire memo screening, warning only; gemini needs GEMINI_API_KEY)
IDV_PROVIDER=stub            # stub | stripe               (stripe needs STRIPE_SECRET_KEY + STRIPE_IDENTITY_WEBHOOK_SECRET)

# ─── Secrets (Functions secrets in deployed envs; >= 32 chars, no fallback) ──
PROOFLINE_AUTH_JWT_SECRET=
BILATERAL_JWT_SECRET=
COSIGN_REFRESH_SECRET=

# Firebase
FIREBASE_PROJECT_ID=

# On-chain anchoring (ANCHOR_PROVIDER=base-sepolia)
BASE_SEPOLIA_RPC=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=

# Cloud KMS company root keys (KMS_PROVIDER=gcp)
KMS_PROJECT=
KMS_LOCATION=us-central1
KMS_KEYRING=proofline-roots

# Email (EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM_DOMAIN=

# KYB (KYB_PROVIDER=baselayer | cobalt; Functions secrets in deployed envs)
BASELAYER_API_KEY=
BASELAYER_WEBHOOK_SECRET=
COBALT_API_KEY=

# Officer identity (IDV_PROVIDER=stripe; Functions secrets in deployed envs)
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Wire memo screening (AI_PROVIDER=gemini; Functions secret in deployed envs)
GEMINI_API_KEY=
GEMINI_MODEL=                # optional, defaults to gemini-3.5-flash-lite

# Observability
SENTRY_DSN=
