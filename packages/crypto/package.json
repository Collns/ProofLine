{
    "name": "@proofline/crypto",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./providers/gcp-kms": {
            "types": "./dist/providers/gcp-kms.d.ts",
            "import": "./dist/providers/gcp-kms.js",
            "default": "./dist/providers/gcp-kms.js"
        },
        "./providers/stub": {
            "types": "./dist/providers/stub.d.ts",
            "import": "./dist/providers/stub.js",
            "default": "./dist/providers/stub.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist"
    },
    "devDependencies": {
        "@types/node": "25.6.2",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@google-cloud/kms": "5.5.0"
    }
}
