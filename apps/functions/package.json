{
    "name": "@proofline/functions",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "node esbuild.config.mjs",
        "build:tsc": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist",
        "deploy": "pnpm build && firebase deploy --only functions"
    },
    "devDependencies": {
        "@types/express": "^4.17.25",
        "@types/supertest": "7.2.0",
        "@types/uuid": "11.0.0",
        "esbuild": "^0.24.0",
        "supertest": "7.2.2",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@proofline/anchoring": "workspace:*",
        "@proofline/canonical": "workspace:*",
        "@proofline/email": "workspace:*",
        "@proofline/onboarding": "workspace:*",
        "@proofline/policy": "workspace:*",
        "@proofline/sessions": "workspace:*",
        "@proofline/types": "workspace:*",
        "@proofline/verification": "workspace:*",
        "@proofline/webauthn": "workspace:*",
        "@proofline/bilateral": "workspace:*",
        "@simplewebauthn/server": "^10.0.0",
        "express": "^4.21.2",
        "firebase-admin": "13.9.0",
        "firebase-functions": "7.2.5",
        "jose": "6.2.3",
        "stripe": "22.1.1",
        "uuid": "14.0.0",
        "zod": "catalog:"
    }
}
